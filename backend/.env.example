PORT=5000

# ── Local MongoDB (installed on this machine) ──
MONGO_URI=mongodb://127.0.0.1:27017/bhoomisetu

# ── OR MongoDB Atlas (paste your Atlas connection string here instead) ──
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bhoomisetu?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
