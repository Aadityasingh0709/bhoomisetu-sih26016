PORT=5000

# ── Local MongoDB (installed on this machine) ──
MONGO_URI=mongodb://127.0.0.1:27017/bhoomisetu

# ── OR MongoDB Atlas (paste your Atlas connection string here instead) ──
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bhoomisetu?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# ══════════════════════════════════════════════════════════════════════
# DIRECT EMAIL DELIVERY CONFIGURATION (Optional - for real inbox delivery)
# ══════════════════════════════════════════════════════════════════════
# OPTION 1: Free Gmail App Password (Recommended for quick testing)
# Step 1: Turn on 2-Step Verification in your Google Account
# Step 2: Go to https://myaccount.google.com/apppasswords and generate an App Password for "Mail"
# Step 3: Paste below:
# GMAIL_USER=yourname@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# OPTION 2: Custom SMTP (Brevo / SendGrid / Amazon SES / Corporate Mail)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
# FROM_EMAIL="BhoomiSetu National Portal" <noreply@bhoomisetu.gov.in>

# ══════════════════════════════════════════════════════════════════════
# DIRECT WHATSAPP CLOUD DELIVERY (Optional)
# ══════════════════════════════════════════════════════════════════════
# OPTION 1: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_NUMBER=+14155238886

# OPTION 2: Meta WhatsApp Cloud API
# WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
